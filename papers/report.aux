\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Exploratory carbon-storage valuation maps. (A) Live aboveground carbon stock-value density in 2025, valued at \$46/tCO$_2$ in 2007 USD and restricted to the ESA 2022 forest footprint. (B) Percentage stock-value change from 2005 to 2025 on shared forest pixels with positive baseline value. Change includes both modeled carbon and SCC price changes. Gray cells are outside the eligible mapped support, not zero-valued forest.}}{20}{figure.4}\protected@file@percent }
\newlabel{fig:carbon-storage-maps}{{4}{20}{Exploratory carbon-storage valuation maps. (A) Live aboveground carbon stock-value density in 2025, valued at \$46/tCO$_2$ in 2007 USD and restricted to the ESA 2022 forest footprint. (B) Percentage stock-value change from 2005 to 2025 on shared forest pixels with positive baseline value. Change includes both modeled carbon and SCC price changes. Gray cells are outside the eligible mapped support, not zero-valued forest}{figure.4}{}}
