\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Exploratory change in annual gross stumpage-value density from the 2001--2005 FIA window to the 2021--2025 window, on shared forest pixels with positive 2005 baseline value. DNR stumpage prices are year-specific nominal values (2005, 2010, 2015, 2020, and 2021 for the respective FIA windows); thus mapped change reflects both timber-yield and price changes and is not inflation-adjusted. Pixel patterns are not validated hotspots.}}{15}{figure.4}\protected@file@percent }
\newlabel{fig:timber-value-change}{{4}{15}{Exploratory change in annual gross stumpage-value density from the 2001--2005 FIA window to the 2021--2025 window, on shared forest pixels with positive 2005 baseline value. DNR stumpage prices are year-specific nominal values (2005, 2010, 2015, 2020, and 2021 for the respective FIA windows); thus mapped change reflects both timber-yield and price changes and is not inflation-adjusted. Pixel patterns are not validated hotspots}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Descriptive five-year series of annual sustainable cord-product quantity, sawtimber quantity, and gross stumpage-value proxy. Each point extrapolates the unweighted FIA plot-mean rate to the mapped forest area for that target year; the 2025 window uses 2021 DNR prices, the latest available. Values are nominal USD and are not design-based statewide estimates.}}{16}{figure.5}\protected@file@percent }
\newlabel{fig:timber-value-series}{{5}{16}{Descriptive five-year series of annual sustainable cord-product quantity, sawtimber quantity, and gross stumpage-value proxy. Each point extrapolates the unweighted FIA plot-mean rate to the mapped forest area for that target year; the 2025 window uses 2021 DNR prices, the latest available. Values are nominal USD and are not design-based statewide estimates}{figure.5}{}}
