\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Exploratory nongame habitat-quality valuation. (A) Signed 2025 annual value density from BBS landbird diversity relative to the 1966--1970 baseline, on the ESA 2022 forest mask. (B) Absolute difference in annual value density between 2005 and 2025 on shared forest pixels. Blue indicates gains; red indicates losses. Gray cells are outside the eligible mapped support. Surfaces are smoothed model interpolations of roadside survey routes, not censuses of biodiversity.}}{24}{figure.10}\protected@file@percent }
\newlabel{fig:biodiversity-maps}{{10}{24}{Exploratory nongame habitat-quality valuation. (A) Signed 2025 annual value density from BBS landbird diversity relative to the 1966--1970 baseline, on the ESA 2022 forest mask. (B) Absolute difference in annual value density between 2005 and 2025 on shared forest pixels. Blue indicates gains; red indicates losses. Gray cells are outside the eligible mapped support. Surfaces are smoothed model interpolations of roadside survey routes, not censuses of biodiversity}{figure.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces BBS route-year landbird diversity near Minnesota and the statewide WTP-valued habitat-quality change. The upper panel shows route-year effective species, the model's statewide forest mean, and the 1966--1970 baseline window. The lower panel compares target-year households with a fixed 2005-household valuation. The 2020 BBS field season was largely cancelled, so 2020 is a model interpolation. Connecting lines are descriptive rather than annual observations.}}{25}{figure.11}\protected@file@percent }
\newlabel{fig:biodiversity-series}{{11}{25}{BBS route-year landbird diversity near Minnesota and the statewide WTP-valued habitat-quality change. The upper panel shows route-year effective species, the model's statewide forest mean, and the 1966--1970 baseline window. The lower panel compares target-year households with a fixed 2005-household valuation. The 2020 BBS field season was largely cancelled, so 2020 is a model interpolation. Connecting lines are descriptive rather than annual observations}{figure.11}{}}
